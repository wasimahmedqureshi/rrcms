// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  role          String   @default("data_entry") // super_admin, office_admin, data_entry
  officeId      String?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  office        Office?  @relation(fields: [officeId], references: [id])
  auditLogs     AuditLog[]
}

// Office Management
model Office {
  id            String   @id @default(cuid())
  officeName    String   @unique
  officeCode    String?  @unique
  address       String?
  district      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
  pendingCases  PendingCase[]
  disposedCases DisposedCase[]
}

// Section Management
model Section {
  id            String   @id @default(cuid())
  sectionName   String   @unique
  sectionCode   String?  @unique
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pendingCases  PendingCase[]
  disposedCases DisposedCase[]
}

// Pending Cases
model PendingCase {
  id              String   @id @default(cuid())
  caseNo          String
  sectionId       String
  institutionDate DateTime
  purpose         String
  appellant       String
  respondent      String
  hearingDate     DateTime?
  officeId        String
  status          String   @default("pending") // pending, in_progress, disposed
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  section         Section  @relation(fields: [sectionId], references: [id])
  office          Office   @relation(fields: [officeId], references: [id])

  @@unique([caseNo, officeId])
}

// Disposed Cases
model DisposedCase {
  id              String   @id @default(cuid())
  caseNo          String
  sectionId       String
  institutionDate DateTime
  disposalDate    DateTime
  purpose         String
  appellant       String
  respondent      String
  officeId        String
  disposalType    String?  // order, judgment, etc.
  disposalRemarks String?
  disposedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  section         Section  @relation(fields: [sectionId], references: [id])
  office          Office   @relation(fields: [officeId], references: [id])

  @@unique([caseNo, officeId])
}

// Audit Logs
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // create, update, delete, login, logout
  entityType  String   // case, user, office, section
  entityId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

// Notifications
model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   // hearing, disposal, registration, system
  isRead      Boolean  @default(false)
  entityId    String?
  entityType  String?
  createdAt   DateTime @default(now())
}

// Settings
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// Import History
model ImportHistory {
  id          String   @id @default(cuid())
  fileName    String
  fileType    String   // pending, disposed
  totalCount  Int
  successCount Int
  errorCount  Int
  importedBy  String
  status      String   // pending, completed, failed
  errors      String?  // JSON string of errors
  createdAt   DateTime @default(now())
}
